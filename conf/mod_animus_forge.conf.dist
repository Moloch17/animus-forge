#
# mod-animus-forge -- in-process training scenarios for the Animus Forge sim host.
#
[worldserver]

###################################################################################################
# GENERAL
#
#    AnimusForge.Enable
#        Description: Enable the module. When disabled it creates no bots, opens no socket and
#                     every hook returns immediately.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AnimusForge.Enable = 1

#
#    AnimusForge.OutputDir
#        Description: Where training writes its data: runs/<scenario>/ (checkpoints, metrics, evaluation)
#                     and layouts/<scenario>/ (each model's layout manifest and the stage's stage.json).
#                     Relative to AnimusForge.Learner.WorkDir, or absolute. The Docker ac-worldserver
#                     service sets it to /azerothcore/var/animus-forge.
#        Default:     "" - (the learner's directory, the module's python/)

AnimusForge.OutputDir = ""

###################################################################################################
# QUEUE
#
#    AnimusForge.Queue
#        Description: Comma-separated scenarios to train one after another, starting when the server
#                     starts. Every env in the pool runs the current scenario. Each runs until its
#                     auto-started learner finishes (its evaluation score plateaus or it reaches
#                     total_env_steps, and it exits cleanly), then the next one starts; when the last
#                     one finishes the sim idles. Moving on needs AnimusForge.Policy = "remote" and
#                     AnimusForge.Learner.AutoStart = 1 (see AnimusForge.Queue.LocalEpisodes for local
#                     policies). An unknown name stops the server at startup and logs the list of
#                     available scenarios. Like any config key it can also be set from the environment:
#                     AC_ANIMUS_FORGE_QUEUE.
#        Values:      Class/role curriculum: one policy for every class/role of AnimusForge.ClassRoles,
#                     one scenario per stage. Every episode each learned seat is a new character of a
#                     class/role: a random race the class allows, gender, level (1-80; 55-80 for death
#                     knights), one of the role's specs with a random talent build, the trainer spells
#                     of the level, and random level-appropriate gear and trinkets for the spec. Each
#                     class/role is a layout of the policy and exports as its own model. Each stage's
#                     layouts extend the stage it builds on, which seeds it:
#                       "class_role"           - a training dummy: maximise damage
#                       "class_role_duel"      - a same-level creature out of aggro range: close in and
#                                                kill it fast, taking little damage
#                       "class_role_pack"      - a pack of 2-4 (casters, usually linked): targets,
#                                                interrupts, crowd control
#                       "class_role_gauntlet"  - pull after pull with short breaks: heals, food, drink
#                       "class_role_companion" - the gauntlet beside a scripted owner: follow, assist,
#                                                guard and heal it
#                       "class_role_party"     - up to four learned seats and the scripted owner against
#                                                elite-heavy pulls
#                       "class_role_pvp"       - one-on-one against a scripted enemy player
#                       "class_role_arena"     - self-play one-on-one: two learned seats of any classes
#                     Standalone:
#                       "warrior_dummy_20"     - level 20 Arms human warrior on a training dummy, a new
#                                                random Arms talent build every episode
#        Example:     "class_role_duel" - (train a single scenario)
#        Default:     "" - (the whole class/role curriculum, first stage to last)

AnimusForge.Queue = ""

#
#    AnimusForge.Queue.SkipFinished
#        Description: Skip queued scenarios whose run already finished (runs/<scenario>/finished.json
#                     in AnimusForge.OutputDir), so a restart continues the queue where it stopped
#                     instead of training every stage again. To retrain a finished stage, move its run
#                     directory away or set this to 0. Only with an auto-started remote learner.
#        Default:     1 - (Skip finished runs)
#                     0 - (Train every queued scenario, archiving earlier runs)

AnimusForge.Queue.SkipFinished = 1

#
#    AnimusForge.Queue.LocalEpisodes
#        Description: With a local AnimusForge.Policy ("random", a scripted baseline), run this many
#                     episodes (over all envs) per queued scenario, then move to the next. Use it to
#                     smoke-test or baseline every scenario in one server run.
#        Default:     0 - (a local policy runs the first queued scenario forever)

AnimusForge.Queue.LocalEpisodes = 0

#
#    AnimusForge.ClassRoles
#        Description: Comma-separated class/roles the class/role scenarios play (their layouts). A subset
#                     trains a policy for just those, e.g. "warrior_dps, priest_heal". Changing the list
#                     changes the layouts: models of the earlier list do not fit the new one.
#                     Available: warrior_dps, warrior_tank, paladin_heal, paladin_tank, paladin_dps,
#                     hunter_dps, rogue_dps, priest_heal, priest_dps, deathknight_tank, deathknight_dps,
#                     shaman_dps, shaman_heal, mage_dps, warlock_dps, druid_dps, druid_tank, druid_heal
#        Default:     "" - (all of them)

AnimusForge.ClassRoles = ""

###################################################################################################
# ENVIRONMENTS
#
#    AnimusForge.Envs
#        Description: Number of parallel environments. Each env gets its own instance map, so envs
#                     are spread across MapUpdate.Threads.
#        Default:     64

AnimusForge.Envs = 64

#
#    AnimusForge.DecisionTicks
#        Description: World ticks per agent decision; a tick is 50 ms of game time. Per-decision reward
#                     terms are scaled to stay the same per second. Models play at this interval
#                     (mod-animus: Animus.DecisionMs = 50 x DecisionTicks).
#        Default:     2 - (a decision every 100 ms)

AnimusForge.DecisionTicks = 2

#
#    AnimusForge.EpisodeSeconds
#        Description: Game-time length of an episode, in seconds. Episodes end by truncation.
#        Default:     60

AnimusForge.EpisodeSeconds = 60

#
#    AnimusForge.SpawnPoint.MapId
#    AnimusForge.SpawnPoint.X / Y / Z / O
#        Description: Instanceable (dungeon) map and position where each env's bots start. The map
#                     must have an instance_template row. The default is the Old Hillsbrad Foothills
#                     entrance: its nearest creature spawn is 352 yd away, well outside visibility.
#        Default:     560, 2741.9, 1315.2, 14.0, 2.96

AnimusForge.SpawnPoint.MapId = 560
AnimusForge.SpawnPoint.X     = 2741.9
AnimusForge.SpawnPoint.Y     = 1315.2
AnimusForge.SpawnPoint.Z     = 14.0
AnimusForge.SpawnPoint.O     = 2.96

###################################################################################################
# POLICY
#
#    AnimusForge.Policy
#        Description: Who chooses actions.
#        Values:      "remote"          - lock-step with the Python learner over AnimusForge.Socket
#                     "random"          - uniform over unmasked actions
#                     "greedy"          - (class/role stages) first usable spell or trinket
#                     "fight"           - (class/role stages with the duel block) start attacking, run
#                                         to the target, first usable spell; eat and drink between
#                                         gauntlet pulls; heal a hurt owner or teammate
#                     "white_only"      - (warrior_dummy_20) white swings only
#                     "hs_at_threshold" - (warrior_dummy_20) queue Heroic Strike at
#                                         AnimusForge.WarriorDummy20.HsRageThreshold rage or more
#                     "rotation"        - (warrior_dummy_20) levelling priority: Battle Shout,
#                                         Bloodrage, Overpower, Rend, Thunder Clap, Mocking Blow,
#                                         then Heroic Strike at the rage threshold
#        Default:     "remote"

AnimusForge.Policy = "remote"

#
#    AnimusForge.ReportEpisodes
#        Description: Log mean episode statistics every this many completed episodes (all
#                     policies, including remote).
#        Default:     256

AnimusForge.ReportEpisodes = 256

#
#    AnimusForge.Socket
#        Description: Unix domain socket path the remote policy listens on.
#        Default:     "/tmp/animus-forge.sock"

AnimusForge.Socket = "/tmp/animus-forge.sock"

###################################################################################################
# LEARNER
#
#    AnimusForge.Learner.AutoStart
#        Description: With AnimusForge.Policy = "remote", start the Python learner automatically
#                     once the sim is ready, for the current queued scenario:
#                         <Python> -u -m animus.train --config <Config> --socket <AnimusForge.Socket>
#                             --run-name <scenario> --runs-dir <OutputDir>/runs --layouts-dir <OutputDir>/layouts
#                     run in <WorkDir>. Every start trains from scratch: whatever runs/<scenario>/ held is
#                     moved to runs/_archive/<scenario>-<time>/ first (nothing is deleted, and nothing is
#                     resumed). The learner is stopped (and saves latest.pt) when the server shuts down.
#                     Requires Python and the learner's packages where the worldserver runs, and the
#                     module source tree: a native build, or the Docker ac-worldserver service, which
#                     runs the build from the bind-mounted source tree.
#        Default:     1 - (Enabled)
#                     0 - (Disabled, start the learner yourself)

AnimusForge.Learner.AutoStart = 1

#
#    AnimusForge.Learner.WorkDir
#        Description: Directory the learner runs in (the module's python/ directory).
#        Default:     "" - the python/ directory of the module source this server was built from

AnimusForge.Learner.WorkDir = ""

#
#    AnimusForge.Learner.Python
#        Description: Python interpreter for the learner.
#        Default:     "" - <WorkDir>/.venv/bin/python if it exists, otherwise python3 from PATH

AnimusForge.Learner.Python = ""

#
#    AnimusForge.Learner.Config
#        Description: Learner config for every scenario, relative to WorkDir or absolute. The run is
#                     always named after the scenario (--run-name).
#        Default:     "" - configs/<scenario>.yaml

AnimusForge.Learner.Config = ""

#
#    AnimusForge.Learner.Args
#        Description: Extra learner arguments appended to every learner command line, split on spaces
#                     (no quoting). Mostly "--set key=value" to override learner config values for the
#                     whole queue without editing the YAML files, e.g. a short pass over a curriculum.
#        Example:     "--set total_env_steps=5000000 --set eval.every_env_steps=1000000"
#        Default:     ""

AnimusForge.Learner.Args = ""

#
#    AnimusForge.Learner.LogFile
#        Description: File the learner's stdout and stderr are appended to.
#        Default:     "" - animus-learner.log in LogsDir

AnimusForge.Learner.LogFile = ""

###################################################################################################
# WARRIOR_DUMMY_20
#
#    AnimusForge.WarriorDummy20.HsRageThreshold
#        Description: Rage at which warrior_dummy_20's hs_at_threshold and rotation policies queue
#                     Heroic Strike.
#        Default:     15

AnimusForge.WarriorDummy20.HsRageThreshold = 15

###################################################################################################
# CLASS/ROLE TUNING
#
# What the class/role curriculum trains on and what it is paid for: the characters, parties, pulls
# and scripted players it meets, and the reward weights. Every key is optional; a missing one keeps
# the default shown. The effective values are written to <OutputDir>/layouts/<stage>/stage.json and
# copied into every run directory. Per-decision reward terms are tuned per 50 ms decision and scaled
# with AnimusForge.DecisionTicks.

#
#    AnimusForge.ClassRole.Characters.*
#        The seat characters.

#   levels at or above this are "high"
AnimusForge.ClassRole.Characters.HighLevelFirst = 61
#   percent of characters drawn from the high levels
AnimusForge.ClassRole.Characters.HighLevelChance = 50

#
#    AnimusForge.ClassRole.Party.*
#        Which party seats have a character, and their roles.

#   relative chance of 1, 2, 3 or 4 seats with a character
AnimusForge.ClassRole.Party.SizeWeight1 = 20
AnimusForge.ClassRole.Party.SizeWeight2 = 20
AnimusForge.ClassRole.Party.SizeWeight3 = 20
AnimusForge.ClassRole.Party.SizeWeight4 = 40
#   percent: tank, healer, damage dealers instead of drawn roles
AnimusForge.ClassRole.Party.ClassicChance = 50
#   drawn roles: percent tanks, healers, the rest damage dealers
AnimusForge.ClassRole.Party.RoleTankChance = 25
AnimusForge.ClassRole.Party.RoleHealerChance = 25
#   damage dealers: a non-tank teammate's damage taken
AnimusForge.ClassRole.Party.TeammateDamageTakenDps = 0.5
#   tanks and healers
AnimusForge.ClassRole.Party.TeammateDamageTakenProtector = 1.0
#   healers: effective healing, fraction of its health
AnimusForge.ClassRole.Party.TeammateHealing = 2.0
#   tanks: per enemy on a non-tank teammate, per decision
AnimusForge.ClassRole.Party.TankLoseTeammate = 0.02
AnimusForge.ClassRole.Party.TeammateDeath = 3.0

#
#    AnimusForge.ClassRole.Dummy.*
#        The training dummy's health curve (it cannot die: execute-range features need a
#        health that moves).

#   start in [min, 1], end in [0, start]
AnimusForge.ClassRole.Dummy.StartHealthMin = 0.2

#
#    AnimusForge.ClassRole.Duel.*
#        One-on-one fights against a creature (the duel) or a player (PvP).

#   fraction of the opponent's health: a kill is worth this in damage
AnimusForge.ClassRole.Duel.DamageDealt = 2.0
#   fraction of the bot's health
AnimusForge.ClassRole.Duel.DamageTaken = 1.0
#   shaping toward the spec's range, per 40 yd closed
AnimusForge.ClassRole.Duel.Approach = 0.5
AnimusForge.ClassRole.Duel.StealthOpener = 0.5
#   per decision
AnimusForge.ClassRole.Duel.StepCost = 0.0002
AnimusForge.ClassRole.Duel.Kill = 2.0
#   times the fraction of the episode still left
AnimusForge.ClassRole.Duel.FastKill = 3.0
#   times the fraction of the bot's health not lost
AnimusForge.ClassRole.Duel.HealthKept = 2.0
AnimusForge.ClassRole.Duel.Death = 3.0
#   the range the approach shaping aims for, melee specs
AnimusForge.ClassRole.Duel.MeleeRange = 3.5
#   ... ranged specs
AnimusForge.ClassRole.Duel.RangedRange = 25.0

#
#    AnimusForge.ClassRole.Casting.*
#        Cast-time spells, from the duel stage on.

#   per second spent on a cast that did not finish
AnimusForge.ClassRole.Casting.TimeWasted = 0.03
#   per second of cast time of a cast that finished, in combat
AnimusForge.ClassRole.Casting.TimeCompleted = 0.03

#
#    AnimusForge.ClassRole.Pulls.*
#        Packs and the gauntlet's pull after pull.

#   percent of pulls whose members aggro together
AnimusForge.ClassRole.Pulls.LinkedChance = 70
#   gauntlet: a single elite instead of a pack
AnimusForge.ClassRole.Pulls.EliteChance = 15
#   gauntlet: a pack 1-3 levels above the bot
AnimusForge.ClassRole.Pulls.HigherLevelChance = 25
#   party: per pack member
AnimusForge.ClassRole.Pulls.PartyEliteChance = 50
#   gauntlet: the break between pulls
AnimusForge.ClassRole.Pulls.NextPullMinMs = 8000
AnimusForge.ClassRole.Pulls.NextPullMaxMs = 20000
#   with an owner: when it walks over to a new pull
AnimusForge.ClassRole.Pulls.OwnerEngageMinMs = 1500
AnimusForge.ClassRole.Pulls.OwnerEngageMaxMs = 5000
#   ... in a party, after the tank has had time to pull
AnimusForge.ClassRole.Pulls.PartyOwnerEngageMinMs = 4000
AnimusForge.ClassRole.Pulls.PartyOwnerEngageMaxMs = 7000
#   ... when the owner starts the pull itself
AnimusForge.ClassRole.Pulls.OwnerPullsMinMs = 500
AnimusForge.ClassRole.Pulls.OwnerPullsMaxMs = 1500
#   percent of pulls a damage dealer or healer owner starts (tanks: all)
AnimusForge.ClassRole.Pulls.OwnerPullsChance = 30
#   owner stages: health and mana the dead stand up with after a pull
AnimusForge.ClassRole.Pulls.RecoverFraction = 0.5
#   fraction of the pull's total health
AnimusForge.ClassRole.Pulls.DamageDealt = 2.0
#   pack: fraction of the bot's health
AnimusForge.ClassRole.Pulls.DamageTaken = 1.0
#   gauntlet on: surviving many pulls matters more than any one
AnimusForge.ClassRole.Pulls.GauntletDamageTaken = 1.5
AnimusForge.ClassRole.Pulls.Approach = 0.5
AnimusForge.ClassRole.Pulls.StealthOpener = 0.5
AnimusForge.ClassRole.Pulls.Interrupt = 0.3
AnimusForge.ClassRole.Pulls.Kill = 0.5
#   per decision
AnimusForge.ClassRole.Pulls.StepCost = 0.0002
AnimusForge.ClassRole.Pulls.Clear = 2.0
#   pack: times the fraction of the episode still left
AnimusForge.ClassRole.Pulls.FastClear = 3.0
#   gauntlet: times 1 - pull time / 60 s
AnimusForge.ClassRole.Pulls.FastPull = 2.0
#   times the fraction of the bot's health not lost this pull
AnimusForge.ClassRole.Pulls.HealthKept = 2.0
AnimusForge.ClassRole.Pulls.PackDeath = 3.0
AnimusForge.ClassRole.Pulls.GauntletDeath = 5.0
#   owner stages: kills and clears count this many times
AnimusForge.ClassRole.Pulls.OwnerClearScale = 2.0

#
#    AnimusForge.ClassRole.Owner.*
#        The scripted owner of the companion and party stages.

#   its level: the bot's plus or minus this
AnimusForge.ClassRole.Owner.LevelSpread = 2
#   percent tanks, healers, the rest damage dealers
AnimusForge.ClassRole.Owner.TankChance = 25
AnimusForge.ClassRole.Owner.HealerChance = 25
#   damage dealers: the owner's damage taken, fraction of its health
AnimusForge.ClassRole.Owner.DamageTakenDps = 1.0
#   tanks and healers exist to prevent it
AnimusForge.ClassRole.Owner.DamageTakenProtector = 2.0
#   a tank owner is hit by design: its damage taken counts this much
AnimusForge.ClassRole.Owner.TankOwnerDamageShare = 0.25
#   healers: effective healing, fraction of the owner's health
AnimusForge.ClassRole.Owner.Healing = 2.0
#   tanks: soften the pulls' damage taken
AnimusForge.ClassRole.Owner.TankDamageRefund = 0.5
#   tanks: per enemy on the tank, per decision
AnimusForge.ClassRole.Owner.TankHold = 0.002
#   tanks: per enemy on the owner, per decision
AnimusForge.ClassRole.Owner.TankLose = 0.02
#   damage dealers and healers: per enemy on the bot, per decision
AnimusForge.ClassRole.Owner.PulledThreat = 0.004
#   per decision in combat while the owner is not
AnimusForge.ClassRole.Owner.SoloFight = 0.01
#   per decision out of combat beyond FollowFarDistance
AnimusForge.ClassRole.Owner.FollowFar = 0.002
#   per decision out of combat within FollowNearDistance
AnimusForge.ClassRole.Owner.FollowNear = 0.0005
AnimusForge.ClassRole.Owner.FollowFarDistance = 25.0
AnimusForge.ClassRole.Owner.FollowNearDistance = 12.0
AnimusForge.ClassRole.Owner.Death = 6.0

#
#    AnimusForge.ClassRole.Opponent.*
#        The scripted enemy player of the PvP stage.

AnimusForge.ClassRole.Opponent.LevelSpread = 1
#   it starts fighting up to this long into the episode
AnimusForge.ClassRole.Opponent.EngageMaxMs = 3000
AnimusForge.ClassRole.Opponent.HealerChance = 20
AnimusForge.ClassRole.Opponent.TankChance = 20

#
#    AnimusForge.ClassRole.ScriptedPlayers.*
#        How the scripted players (owner, PvP opponent) play.

#   time between damage spells
AnimusForge.ClassRole.ScriptedPlayers.SpellMinMs = 2000
AnimusForge.ClassRole.ScriptedPlayers.SpellMaxMs = 4000
#   time between heals
AnimusForge.ClassRole.ScriptedPlayers.HealMinMs = 1500
AnimusForge.ClassRole.ScriptedPlayers.HealMaxMs = 2500
#   between pulls: time between wander steps
AnimusForge.ClassRole.ScriptedPlayers.WanderMinMs = 6000
AnimusForge.ClassRole.ScriptedPlayers.WanderMaxMs = 12000
#   of max health and mana per second, out of combat
AnimusForge.ClassRole.ScriptedPlayers.RegenFraction = 0.04
#   healers heal party members under this health fraction
AnimusForge.ClassRole.ScriptedPlayers.HealBelow = 0.85
#   PvP healers heal themselves under this
AnimusForge.ClassRole.ScriptedPlayers.SelfHealBelow = 0.6
#   healers stay this close to the tank
AnimusForge.ClassRole.ScriptedPlayers.HealerRange = 30.0
AnimusForge.ClassRole.ScriptedPlayers.TauntRange = 25.0
#   PvP: a ranged spec backs off inside half this ...
AnimusForge.ClassRole.ScriptedPlayers.RangedMin = 20.0
#   ... and closes in beyond this
AnimusForge.ClassRole.ScriptedPlayers.RangedMax = 30.0

###################################################################################################
