#
# mod-animus-forge -- in-process training scenarios for the Animus Forge sim host.
#
[worldserver]

###################################################################################################
# GENERAL
#
#    AnimusForge.Enable
#        Description: Enable the module. When disabled it creates no bots, opens no socket and
#                     every hook returns immediately.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AnimusForge.Enable = 0

###################################################################################################
# SCENARIO
#
#    AnimusForge.Scenario
#        Description: Training scenario started automatically when the server starts. Every env
#                     in the pool runs the same scenario. An unknown name stops the server at
#                     startup and logs the list of available scenarios. Like any config key it can
#                     also be set from the environment: AC_ANIMUS_FORGE_SCENARIO.
#        Values:      "warrior_dummy"    - level 1 human warrior maximising DPS on a training dummy
#                     "warrior_dummy_20" - level 20 Arms human warrior in level 16-20 gear with the
#                                          full level 20 trainer kit on a training dummy; a new
#                                          random Arms talent build (one of all valid 11-point
#                                          builds) every episode
#                     Class/role curriculum: one policy for every class/role of AnimusForge.ClassRoles,
#                     one scenario per stage. Every episode each learned seat is a new character of a
#                     class/role: a random race the class allows, gender, level (1-80; 55-80 for death
#                     knights), one of the role's specs with a random talent build that fills the
#                     spec's tree to its 51-point capstone first and spreads the rest over the other
#                     trees, the trainer spells of the level, and random level-appropriate gear and
#                     trinkets for the spec. Each class/role is a layout of the policy (its own
#                     observations and actions around a shared trunk) and exports as its own model.
#                     Each stage's layouts extend the previous stage's, which seeds it:
#                       "class_role"           - a training dummy: maximise damage
#                       "class_role_duel"      - a same-level creature out of aggro range: move to it
#                                                and kill it fast, taking little damage; pets are the
#                                                policy's to summon, stealth openers rewarded
#                       "class_role_pack"      - a pack of 2-4 (casters, usually linked): targets,
#                                                interrupts, crowd control
#                       "class_role_gauntlet"  - pull after pull with short breaks: heals, food, drink
#                       "class_role_companion" - the gauntlet beside a scripted owner of a random class:
#                                                follow, assist, guard and heal it
#                       "class_role_party"     - four learned seats (tank, healer, two damage dealers)
#                                                and the scripted owner against elite-heavy pulls
#                       "class_role_pvp"       - one-on-one against a scripted enemy player
#                       "class_role_arena"     - self-play one-on-one: two learned seats of any classes
#        Default:     "warrior_dummy"

AnimusForge.Scenario = "warrior_dummy"

#
#    AnimusForge.Queue
#        Description: Comma-separated scenarios to train one after another, overriding
#                     AnimusForge.Scenario. Each runs until its auto-started learner finishes
#                     (reaches total_env_steps and exits cleanly), then the next one starts. After a
#                     restart the finished scenarios' learners exit at once and the queue moves on.
#                     When the last one finishes the sim idles. Needs AnimusForge.Policy = "remote"
#                     and AnimusForge.Learner.AutoStart = 1. Each scenario trains in runs/<scenario>/
#                     and publishes <scenario>.amdl. Can be set from the environment:
#                     AC_ANIMUS_FORGE_QUEUE.
#        Example:     "class_role, class_role_duel, class_role_pack, class_role_gauntlet,
#                      class_role_companion, class_role_party, class_role_pvp, class_role_arena"
#        Default:     "" - (run AnimusForge.Scenario only)

AnimusForge.Queue = ""

#
#    AnimusForge.ClassRoles
#        Description: Comma-separated class/roles the class/role scenarios play (their layouts). A subset
#                     trains a policy for just those, e.g. "warrior_dps, priest_heal". Changing the list
#                     changes the layouts: models of the earlier list do not fit the new one.
#                     Available: warrior_dps, warrior_tank, paladin_heal, paladin_tank, paladin_dps,
#                     hunter_dps, rogue_dps, priest_heal, priest_dps, deathknight_tank, deathknight_dps,
#                     shaman_dps, shaman_heal, mage_dps, warlock_dps, druid_dps, druid_tank, druid_heal
#        Default:     "" - (all of them)

AnimusForge.ClassRoles = ""

#
#    AnimusForge.Queue.LocalEpisodes
#        Description: With a local AnimusForge.Policy ("random", a scripted baseline), run this many
#                     episodes (over all envs) per queued scenario, then move to the next. Use it to
#                     smoke-test or baseline every scenario in one server run.
#        Default:     0 - (a local policy runs the first queued scenario forever)

AnimusForge.Queue.LocalEpisodes = 0

#
#    AnimusForge.Envs
#        Description: Number of parallel environments. Each env gets its own instance map, so envs
#                     are spread across MapUpdate.Threads.
#        Default:     64

AnimusForge.Envs = 64

#
#    AnimusForge.DecisionTicks
#        Description: World ticks per agent decision; a tick is 50 ms of game time. Per-decision reward
#                     terms are scaled to stay the same per second. Models play at this interval
#                     (mod-animus: Animus.DecisionMs = 50 x DecisionTicks).
#        Default:     2 - (a decision every 100 ms)

AnimusForge.DecisionTicks = 2

#
#    AnimusForge.EpisodeSeconds
#        Description: Game-time length of an episode, in seconds. Episodes end by truncation.
#        Default:     60

AnimusForge.EpisodeSeconds = 60

###################################################################################################
# POLICY
#
#    AnimusForge.Policy
#        Description: Who chooses actions.
#        Values:      "remote"          - lock-step with the Python learner over AnimusForge.Socket
#                     "random"          - uniform over unmasked actions
#                     "never_hs"        - (warrior_dummy) white swings only
#                     "white_only"      - (warrior_dummy_20) white swings only
#                     "hs_at_threshold" - (both) queue Heroic Strike at AnimusForge.HsRageThreshold
#                                         rage or more
#                     "rotation"        - (warrior_dummy_20) levelling priority: Battle Shout,
#                                         Bloodrage, Overpower, Rend, Thunder Clap, Mocking Blow,
#                                         then Heroic Strike at the rage threshold
#                     "greedy"          - (class/role scenarios) first usable spell or trinket
#                     "fight"           - (class/role duel stage on) start attacking, run
#                                         to the target, first usable spell; eat and drink
#                                         between gauntlet pulls; heal a hurt companion owner
#                                         (leaving a form to do it)
#        Default:     "remote"

AnimusForge.Policy = "remote"

#
#    AnimusForge.HsRageThreshold
#        Description: Rage at which the hs_at_threshold policy queues Heroic Strike.
#        Default:     15

AnimusForge.HsRageThreshold = 15

#
#    AnimusForge.ReportEpisodes
#        Description: Log mean episode statistics every this many completed episodes (all
#                     policies, including remote).
#        Default:     256

AnimusForge.ReportEpisodes = 256

#
#    AnimusForge.Socket
#        Description: Unix domain socket path the remote policy listens on.
#        Default:     "/tmp/animus-forge.sock"

AnimusForge.Socket = "/tmp/animus-forge.sock"

###################################################################################################
# LEARNER
#
#    AnimusForge.Learner.AutoStart
#        Description: With AnimusForge.Policy = "remote", start the Python learner automatically
#                     once the sim is ready, for the selected scenario:
#                         <Python> -u -m animus.train --config <Config> --socket <AnimusForge.Socket>
#                     run in <WorkDir>. Every start trains from scratch: whatever runs/<scenario>/ held is
#                     moved to runs/_archive/<scenario>-<time>/ first (nothing is deleted, and nothing is
#                     resumed). The learner is stopped (and saves latest.pt) when the server shuts down.
#                     Requires Python and the learner's packages where the worldserver runs: a
#                     native build or the dev-server container, not the ac-worldserver image.
#        Default:     1 - (Enabled)
#                     0 - (Disabled, start the learner yourself)

AnimusForge.Learner.AutoStart = 1

#
#    AnimusForge.Learner.WorkDir
#        Description: Directory the learner runs in (the module's python/ directory).
#        Default:     "" - the python/ directory of the module source this server was built from

AnimusForge.Learner.WorkDir = ""

#
#    AnimusForge.Learner.Python
#        Description: Python interpreter for the learner.
#        Default:     "" - <WorkDir>/.venv/bin/python if it exists, otherwise python3 from PATH

AnimusForge.Learner.Python = ""

#
#    AnimusForge.Learner.Config
#        Description: Learner config for every scenario, relative to WorkDir or absolute. The run is
#                     always named after the scenario (--run-name).
#        Default:     "" - configs/<scenario>.yaml if it exists, else configs/class_role.yaml

AnimusForge.Learner.Config = ""

#
#    AnimusForge.Learner.Args
#        Description: Extra learner arguments appended to every learner command line, split on spaces
#                     (no quoting). Mostly "--set key=value" to override learner config values for the
#                     whole queue without editing the YAML files, e.g. a short pass over a curriculum.
#        Example:     "--set total_env_steps=5000000 --set eval.every_env_steps=1000000"
#        Default:     ""

AnimusForge.Learner.Args = ""

#
#    AnimusForge.Learner.LogFile
#        Description: File the learner's stdout and stderr are appended to.
#        Default:     "" - animus-learner.log in LogsDir

AnimusForge.Learner.LogFile = ""

###################################################################################################
# ARENA
#
#    AnimusForge.Arena.MapId
#    AnimusForge.Arena.X / Y / Z / O
#        Description: Instanceable (dungeon) map and position where each env's bots stand. The map
#                     must have an instance_template row. The default is the Old Hillsbrad Foothills
#                     entrance: its nearest creature spawn is 352 yd away, well outside visibility.
#        Default:     560, 2741.9, 1315.2, 14.0, 2.96

AnimusForge.Arena.MapId = 560
AnimusForge.Arena.X     = 2741.9
AnimusForge.Arena.Y     = 1315.2
AnimusForge.Arena.Z     = 14.0
AnimusForge.Arena.O     = 2.96

###################################################################################################
