#
# mod-animus-forge -- in-process training scenarios for the Animus Forge sim host.
#
[worldserver]

###################################################################################################
# GENERAL
#
#    AnimusForge.Enable
#        Description: Enable the module. When disabled it creates no bots, opens no socket and
#                     every hook returns immediately.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AnimusForge.Enable = 1

#
#    AnimusForge.OutputDir
#        Description: Where training writes its data: runs/<scenario>/ (checkpoints, metrics, evaluation)
#                     and layouts/<scenario>/ (each model's layout manifest and the stage's stage.json).
#                     Relative to the directory of worldserver.conf, or absolute. The Docker ac-worldserver
#                     service sets it to /azerothcore/var/animus-forge.
#        Default:     "" - (the learner's directory, the module's python/)

AnimusForge.OutputDir = ""

###################################################################################################
# QUEUE
#
#    AnimusForge.Queue
#        Description: Comma-separated scenarios `forge start` trains one after another when it is given
#                     none. The sim starts idle: nothing trains until `forge start` is typed on the
#                     console (`forge help` lists every command). Every env in the pool runs the current
#                     scenario. Each runs until its auto-started learner finishes (its evaluation score
#                     converges and its best networks pass the stage target, or it reaches
#                     total_env_steps, and it exits cleanly), then the next one starts; after the last one
#                     the sim idles again. A stage still below its target after its restarts exits with
#                     code 3 and the plan halts there (see runs/<scenario>/finished.json). Moving on needs
#                     AnimusForge.Policy = "remote" and AnimusForge.Learner.AutoStart = 1 (see
#                     AnimusForge.Queue.LocalEpisodes for local policies). `forge start` rejects an unknown
#                     name and lists the available scenarios. Each scenario trains in
#                     <OutputDir>/runs/<scenario>/. Like any config key it can also be set from the
#                     environment: AC_ANIMUS_FORGE_QUEUE.
#        Values:      Curriculum: one policy for every class/role of AnimusForge.ClassRoles,
#                     one scenario per stage. Every episode each learned seat is a new character of a
#                     class/role: a random race the class allows, gender, level (1-80; 55-80 for death
#                     knights), one of the role's specs with its standard talent build and glyphs, the
#                     trainer spells of the level, gear from the item level band of the level with
#                     enchants and gems, and potions, bandages and stones it learns to use. Each
#                     class/role is a layout of the policy and exports as its own model. Each stage's
#                     layouts extend the stage it builds on, which seeds it:
#                       "stage1_duel"      - a same-level creature out of aggro range: close in and kill
#                                            it fast, taking little damage (the first stage, from scratch)
#                       "stage2_pack"      - a pack of 2-4 (casters, usually linked): targets,
#                                            interrupts, crowd control
#                       "stage3_gauntlet"  - pull after pull with short breaks: heals, food, drink
#                       "stage4_companion" - the gauntlet beside a scripted owner: follow, assist,
#                                            guard and heal it
#                       "stage5_party"     - up to four learned seats and the scripted owner against
#                                            elite-heavy pulls
#                       "stage6_pvp"       - one-on-one against a scripted enemy player (branches off
#                                            the duel)
#                       "stage7_arena"     - self-play one-on-one: two learned seats of any classes
#                       "stage8_crossroads" - PvE and PvP in one policy: every earlier situation, an
#                                            ambush of the owner mid-gauntlet and a ganked owner
#                                            (merges both branches)
#                     Only when named (not in an empty queue):
#                       "mix_duel_pvp"     - pilot arena mix: each episode a creature duel or a scripted
#                                            enemy player (seeds from stage6_pvp)
#        Example:     "stage1_duel" - (train a single scenario)
#        Default:     "" - (the whole curriculum, first stage to last)

AnimusForge.Queue = ""

#
#    AnimusForge.Queue.SkipFinished
#        Description: `forge start` without scenarios leaves out queued scenarios whose run already
#                     finished and moved on (runs/<scenario>/finished.json in AnimusForge.OutputDir with
#                     "advanced": true), so it continues where training stopped instead of training
#                     every stage again. A stage that halted below its target trains again. Scenarios
#                     named on `forge start` always train. To retrain a finished stage, move its run
#                     directory away or set this to 0. Only with the remote policy.
#        Default:     1 - (Skip finished runs)
#                     0 - (Train every queued scenario, archiving earlier runs)

AnimusForge.Queue.SkipFinished = 1

#
#    AnimusForge.Queue.LocalEpisodes
#        Description: With a local AnimusForge.Policy ("random", a scripted baseline), run this many
#                     episodes (over all envs) per queued scenario, then move to the next. Use it to
#                     smoke-test or baseline every scenario in one server run.
#        Default:     0 - (a local policy runs the first queued scenario forever)

AnimusForge.Queue.LocalEpisodes = 0

#
#    AnimusForge.ClassRoles
#        Description: Comma-separated class/roles the curriculum stages play (their layouts). A subset
#                     trains a policy for just those, e.g. "warrior_dps, priest_heal". Changing the list
#                     changes the layouts: models of the earlier list do not fit the new one.
#                     Available: warrior_dps, warrior_tank, paladin_heal, paladin_tank, paladin_dps,
#                     hunter_dps, rogue_dps, priest_heal, priest_dps, deathknight_tank, deathknight_dps,
#                     shaman_dps, shaman_heal, mage_dps, warlock_dps, druid_dps, druid_tank, druid_heal
#        Default:     "" - (all of them)

AnimusForge.ClassRoles = ""

###################################################################################################
# ENVIRONMENTS
#
#    AnimusForge.Envs
#        Description: Number of parallel environments. Each env gets its own instance map, so envs
#                     are spread across MapUpdate.Threads.
#        Default:     64

AnimusForge.Envs = 64

#
#    AnimusForge.DecisionMs
#        Description: Game time per agent decision, in milliseconds. It is also the sim's world tick: the
#                     forge worldserver advances the world this much per update and every update is one
#                     decision, so game time and decisions stay in step. Read once at startup (a change
#                     needs a restart). Per-decision reward terms are scaled to stay the same per second.
#                     Models play at this interval (mod-animus: Animus.ClassRole.DecisionMs and
#                     Animus.Stage.DecisionMs).
#                     250 ms is about a player's reaction time: a decision there has to count for something,
#                     where at 100 ms policies re-decided ten times a second and dithered.
#        Default:     250

AnimusForge.DecisionMs = 250

#
#    AnimusForge.EpisodeSeconds
#        Description: Game-time length of an episode, in seconds. Episodes end by truncation.
#        Default:     60

AnimusForge.EpisodeSeconds = 60

#
#    AnimusForge.SpawnPoint.MapId
#    AnimusForge.SpawnPoint.X / Y / Z / O
#        Description: Instanceable (dungeon) map and position where each env's bots start. The map
#                     must have an instance_template row. The default is the Old Hillsbrad Foothills
#                     entrance: its nearest creature spawn is 352 yd away, well outside visibility.
#        Default:     560, 2741.9, 1315.2, 14.0, 2.96

AnimusForge.SpawnPoint.MapId = 560
AnimusForge.SpawnPoint.X     = 2741.9
AnimusForge.SpawnPoint.Y     = 1315.2
AnimusForge.SpawnPoint.Z     = 14.0
AnimusForge.SpawnPoint.O     = 2.96

###################################################################################################
# POLICY
#
#    AnimusForge.Policy
#        Description: Who chooses actions.
#        Values:      "remote"          - lock-step with the Python learner over AnimusForge.Socket
#                     "random"          - uniform over unmasked actions
#                     "greedy"          - (curriculum stages) first usable spell or trinket
#                     "fight"           - (curriculum stages with the duel block) start attacking, run
#                                         to the target, first usable spell; eat and drink between
#                                         gauntlet pulls; heal a hurt owner or teammate
#        Default:     "remote"

AnimusForge.Policy = "remote"

#
#    AnimusForge.ReportEpisodes
#        Description: Mean episode statistics are taken over this many completed episodes (all
#                     policies, including remote). They show in `forge status` and in the progress report
#                     of local policy runs, and in the log at debug level.
#        Default:     256

AnimusForge.ReportEpisodes = 256

#
#    AnimusForge.Socket
#        Description: Unix domain socket path the remote policy listens on, relative to the directory of
#                     worldserver.conf or absolute.
#        Default:     "/tmp/animus-forge.sock"

AnimusForge.Socket = "/tmp/animus-forge.sock"

###################################################################################################
# LEARNER
#
#    AnimusForge.Learner.AutoStart
#        Description: With AnimusForge.Policy = "remote", start the Python learner automatically
#                     whenever a scenario of `forge start` or `forge resume` is ready:
#                         <Python> -u -m animus.train --config <Config> --socket <AnimusForge.Socket>
#                             --run-name <scenario> --runs-dir <OutputDir>/runs --layouts-dir <OutputDir>/layouts
#                     run in <WorkDir>. `forge start` trains from scratch: whatever runs/<scenario>/ held is
#                     moved to runs/_archive/<scenario>-<time>/ first (nothing is deleted). `forge resume`
#                     adds --resume and continues runs/<scenario>/latest.pt instead. The learner is
#                     stopped (and saves latest.pt) by `forge cancel`, `forge skip` and server shutdown.
#                     Requires Python and the learner's packages where the worldserver runs, and the
#                     module source tree: a native build, or the Docker ac-worldserver service, which
#                     runs the build from the bind-mounted source tree.
#        Default:     1 - (Enabled)
#                     0 - (Disabled, start the learner yourself)

AnimusForge.Learner.AutoStart = 1

#
#    AnimusForge.Learner.WorkDir
#        Description: Directory the learner runs in (the module's python/ directory). Relative to the
#                     directory of worldserver.conf, or absolute.
#        Default:     "" - the python/ directory of the module source this server was built from

AnimusForge.Learner.WorkDir = ""

#
#    AnimusForge.Learner.Python
#        Description: Python interpreter for the learner: a name found on PATH, or a path (relative to the
#                     directory of worldserver.conf, or absolute).
#        Default:     "" - <WorkDir>/.venv/bin/python if it exists, otherwise python3 from PATH

AnimusForge.Learner.Python = ""

#
#    AnimusForge.Learner.Config
#        Description: Learner config for every scenario, relative to the directory of worldserver.conf or
#                     absolute. The run is
#                     always named after the scenario (--run-name).
#        Default:     "" - configs/<scenario>.yaml

AnimusForge.Learner.Config = ""

#
#    AnimusForge.Learner.Args
#        Description: Extra learner arguments appended to every learner command line, split on spaces
#                     (no quoting). Mostly "--set key=value" to override learner config values for the
#                     whole queue without editing the YAML files, e.g. a short pass over a curriculum.
#        Example:     "--set total_env_steps=5000000 --set eval.every_env_steps=1000000"
#        Default:     ""

AnimusForge.Learner.Args = ""

#
#    AnimusForge.Learner.TorchThreads
#        Description: CPU threads the learner's torch may use (--set torch_threads). The learner and the
#                     sim's map update threads (MapUpdate.Threads in worldserver.conf) share the machine,
#                     so leaving torch every core can be slower overall. `forge bench` measures both.
#        Default:     0 - (torch's own default: a thread per core)

AnimusForge.Learner.TorchThreads = 0

#
#    AnimusForge.Learner.LogFile
#        Description: File the learner's stdout and stderr are appended to, relative to the directory of
#                     worldserver.conf or absolute.
#        Default:     "" - animus-learner.log in LogsDir

AnimusForge.Learner.LogFile = ""

###################################################################################################
# BENCHMARK
#
#    `forge bench [scenario]` measures how fast the sim runs at every MapUpdate.Threads x AnimusForge.Envs
#    pair below, then runs the fastest few again with the real learner, and reports the env steps per second
#    of each. It writes bench.json in <OutputDir>/bench and trains nothing: every trial runs in that
#    directory, so runs/ is untouched. `forge bench apply` writes the winner into worldserver.conf and this
#    file (the thread count takes effect on the next restart, the env count at the next `forge start`).
#
#    `forge status` shows the same measurement while training: env steps/s and where a decision's wall time
#    goes -- the world tick (the map update), this module (observing and acting) and waiting on the learner.
#
#    Note: more envs is not only speed. One learner update is rollout_length x envs x seats env steps, so
#    changing the env count changes the batch the learner trains on.
#
#    AnimusForge.Bench.Scenario
#        Description: Scenario the trials run, when `forge bench` is given none. A party stage (four seats
#                     per env) costs more per env than a solo one.
#        Default:     "stage1_duel"

AnimusForge.Bench.Scenario = "stage1_duel"

#
#    AnimusForge.Bench.Policy
#        Description: Local policy the sim-only trials play ("fight", "greedy", "random"). It decides how
#                     much work a decision is, so keep the one closest to a trained policy.
#        Default:     "fight"

AnimusForge.Bench.Policy = "fight"

#
#    AnimusForge.Bench.Threads
#        Description: MapUpdate.Threads values to try, comma-separated. The sim switches the map update
#                     pool between trials, so no restart is needed while benchmarking. Every trial rebuilds
#                     the env pool, so a trial costs its warm-up and measured decisions plus that build:
#                     keep the grid to the counts worth telling apart. More threads than the machine has
#                     cores, once the learner's own threads are counted, only adds trials.
#        Default:     "4, 8, 12, 16"

AnimusForge.Bench.Threads = "4, 8, 12, 16"

#
#    AnimusForge.Bench.Envs
#        Description: AnimusForge.Envs values to try, comma-separated. Big env counts cost the most to
#                     build and to hold, so try the few that could win rather than a wide ladder.
#        Default:     "64, 128, 192"

AnimusForge.Bench.Envs = "64, 128, 192"

#
#    AnimusForge.Bench.MaxEnvs
#        Description: Never try more envs than this, whatever AnimusForge.Bench.Envs says.
#        Default:     256

AnimusForge.Bench.MaxEnvs = 256

#
#    AnimusForge.Bench.WarmupTicks
#        Description: Decisions a sim-only trial runs before it is timed, so the first episode (which every
#                     env starts together) and the cold caches are behind it.
#        Default:     128

AnimusForge.Bench.WarmupTicks = 128

#
#    AnimusForge.Bench.MeasureTicks
#        Description: Decisions timed per sim-only trial. What the window has to average over is episode
#                     ends: an env rebuilds its character there, and that rebuild is part of what training
#                     costs. Episodes end on the kill well before the 60 s limit, so at 64 envs a few
#                     hundred decisions already cover a hundred or so of them and the rate settles to a few
#                     percent. Raise it if trials of the same settings disagree by more than that.
#        Default:     384

AnimusForge.Bench.MeasureTicks = 384

#
#    AnimusForge.Bench.MaxMemoryPercent
#        Description: Once the machine's memory is this used after a trial, the bigger env counts of that
#                     thread count are skipped instead of being built.
#        Default:     80

AnimusForge.Bench.MaxMemoryPercent = 80

#
#    AnimusForge.Bench.LearnerTop
#        Description: How many of the fastest sim trials run again with the real learner, which is what
#                     training actually costs. Each one starts a learner of its own, so this is the
#                     expensive phase; two is enough to tell the top settings apart. 0 = sim only.
#        Default:     2

AnimusForge.Bench.LearnerTop = 2

#
#    AnimusForge.Bench.LearnerWarmupTicks
#        Description: The learner phase's own warm-up, which also has to cover the learner starting up and
#                     its first updates (one update per rollout_length decisions, 128 by default).
#        Default:     384

AnimusForge.Bench.LearnerWarmupTicks = 384

#
#    AnimusForge.Bench.LearnerMeasureTicks
#        Description: Decisions timed per learner trial. Longer than the sim-only window because the cost
#                     being measured now includes updates, which land once per rollout: this averages over
#                     several of them.
#        Default:     768

AnimusForge.Bench.LearnerMeasureTicks = 768

#
#    AnimusForge.Bench.LearnerTorchThreads
#        Description: AnimusForge.Learner.TorchThreads values to try in the learner trials, comma-separated
#                     (0 = torch's own default). Every value is tried with every setting of LearnerTop.
#        Default:     "0, 8"

AnimusForge.Bench.LearnerTorchThreads = "0, 8"

###################################################################################################
# FAST TEST RUN
#
#    `forge fast [scenario ...]` trains stages (default: every curriculum stage) on an easier
#    problem, to see quickly that training works and learns before a long run: fewer envs, a few
#    class/roles at one level, and learner settings that end each stage as soon as its evaluation
#    score stops improving. It always uses the remote policy and trains from scratch, in its own
#    output directory, so it never archives, seeds from or overwrites a real run. Every other
#    setting (decision interval, episode length, rewards) is the one above.
#
#    AnimusForge.Fast.Queue
#        Description: Comma-separated scenarios `forge fast` trains when given none, in order, each again
#                     from scratch (nothing is skipped because an earlier fast run of it finished).
#        Default:     ""  - (every curriculum stage in order, the mix_duel_pvp pilot included: a full run)
#                     "stage1_duel, stage6_pvp, mix_duel_pvp" - (a stage from scratch, one seeded from it, a
#                     scripted enemy player, and a stage that mixes arenas, merges parents and distills)

AnimusForge.Fast.Queue = ""

#
#    AnimusForge.Fast.Envs
#        Description: Parallel envs of a fast run.
#        Default:     32
#
#    AnimusForge.Fast.Level
#        Description: The level of every character in a fast run (raised to a class's starting level, e.g.
#                     55 for death knights). One level means fewer spells, gear and matchups to learn.
#        Default:     20
#                     0  - (the curriculum's random levels, AnimusForge.Curriculum.Characters.*)

AnimusForge.Fast.Envs = 32
AnimusForge.Fast.Level = 20

#
#    AnimusForge.Fast.ClassRoles
#        Description: Comma-separated class/roles a fast run plays (see AnimusForge.ClassRoles). The
#                     default covers a tank, a healer (so stage 5 can form its party), melee with
#                     stealth and energy, and a ranged class with a pet.
#        Default:     "warrior_tank, priest_heal, rogue_dps, hunter_dps"
#                     ""  - (AnimusForge.ClassRoles)

AnimusForge.Fast.ClassRoles = "warrior_tank, priest_heal, rogue_dps, hunter_dps"

#
#    AnimusForge.Fast.OutputDir
#        Description: Where a fast run's runs/, layouts/ and exported models/ go; relative to
#                     AnimusForge.OutputDir. `forge clean fast` deletes it.
#        Default:     "fast"

AnimusForge.Fast.OutputDir = "fast"

#
#    AnimusForge.Fast.Learner.Overlay
#        Description: Learner config merged over every stage's config in a fast run (--overlay),
#                     relative to the directory of worldserver.conf or absolute. The default evaluates
#                     often, ends a stage once its score stops improving (with a step cap as a safety
#                     net) and turns the stage targets off.
#        Default:     "" - configs/fast.yaml

AnimusForge.Fast.Learner.Overlay = ""

#
#    AnimusForge.Fast.Learner.Args
#        Description: Extra learner arguments for fast runs only, after AnimusForge.Learner.Args.
#        Example:     "--set target.min_over_baseline=0.0" - (also test the stage target and restarts)
#        Default:     ""

AnimusForge.Fast.Learner.Args = ""

###################################################################################################
# CONSOLE
#
#    AnimusForge.ModelDir
#        Description: Folder `forge export` writes .amdl models (and their layout manifests) to, relative
#                     to the directory of worldserver.conf or absolute. Models are never copied anywhere else: copy
#                     them to a game server by hand. `forge clean exports` empties it.
#        Default:     "" - models/ in the module source this server was built from

AnimusForge.ModelDir = ""

#
#    AnimusForge.Progress.Interval
#        Description: While a scenario runs, also log the progress report every this many wall-clock
#                     seconds: env steps, step rate, ETAs (step limit, earliest convergence, the whole
#                     plan), evaluation scores against the baseline, restarts, losses and warnings
#                     (stalled learner, falling step rate, entropy collapse, large updates, non-finite
#                     values, convergence close). The report is always printed when a stage ends, and
#                     `forge status` prints it at any time; `forge progress <seconds|off>` changes the
#                     interval until the server restarts.
#        Default:     0  - (no periodic report)

AnimusForge.Progress.Interval = 0

###################################################################################################
# CURRICULUM TUNING
#
# What the curriculum trains on and what it is paid for: the characters, parties, pulls
# and scripted players it meets, and the reward weights. Every key is optional; a missing one keeps
# the default shown. The effective values are written to <OutputDir>/layouts/<stage>/stage.json and
# copied into every run directory. Per-decision reward terms are tuned per 50 ms decision and scaled
# with AnimusForge.DecisionMs.

#
#    AnimusForge.Curriculum.Arena.<stage>.<arena>.Weight
#        Description: A stage's share of episodes for one of its arenas (see stage.json "arenas"), e.g.
#                     AnimusForge.Curriculum.Arena.mix_duel_pvp.duel.Weight = 3 for three duels per
#                     scripted enemy player. Only matters for stages with several arenas.
#        Default:     the stage definition's weight (1 for every arena of the current stages)

#
#    AnimusForge.Curriculum.Characters.*
#        The seat characters.

#   levels at or above this are "high"
AnimusForge.Curriculum.Characters.HighLevelFirst = 61
#   percent of characters drawn from the high levels
AnimusForge.Curriculum.Characters.HighLevelChance = 50
#   levels at or below this are "low"
AnimusForge.Curriculum.Characters.LowLevelLast = 20
#   percent of characters drawn from the low levels (when the class can be that low); the rest are any level
AnimusForge.Curriculum.Characters.LowLevelChance = 15
#   percent of characters: the standard build with its last points moved (0 = never)
AnimusForge.Curriculum.Characters.NoisyTalentChance = 30
#   percent of characters: every talent point spent at random (the rest get the spec's standard build)
AnimusForge.Curriculum.Characters.RandomTalentChance = 10
#   a noisy build moves 1 to this many of its last points
AnimusForge.Curriculum.Characters.TalentNoisePoints = 5
#   percent of pet-class characters (hunters, warlocks, death knights with Master of Ghouls, frost mages with Glyph
#   of Eternal Water) that start with their pet out, as a player arrives with one
AnimusForge.Curriculum.Characters.PetOutChance = 50

#
#    AnimusForge.Curriculum.Party.*
#        Which party seats have a character, and their roles.

#   relative chance of 1, 2, 3 or 4 seats with a character
AnimusForge.Curriculum.Party.SizeWeight1 = 20
AnimusForge.Curriculum.Party.SizeWeight2 = 20
AnimusForge.Curriculum.Party.SizeWeight3 = 20
AnimusForge.Curriculum.Party.SizeWeight4 = 40
#   percent: tank, healer, damage dealers instead of drawn roles
AnimusForge.Curriculum.Party.ClassicChance = 50
#   drawn roles: percent tanks, healers, the rest damage dealers
AnimusForge.Curriculum.Party.RoleTankChance = 25
AnimusForge.Curriculum.Party.RoleHealerChance = 25
#   damage dealers: a non-tank teammate's damage taken
AnimusForge.Curriculum.Party.TeammateDamageTakenDps = 0.5
#   tanks and healers
AnimusForge.Curriculum.Party.TeammateDamageTakenProtector = 1.0
#   healers: effective healing, fraction of its health
AnimusForge.Curriculum.Party.TeammateHealing = 2.0
#   tanks: per enemy on a non-tank teammate, per decision
AnimusForge.Curriculum.Party.TankLoseTeammate = 0.02
AnimusForge.Curriculum.Party.TeammateDeath = 3.0

#
#    AnimusForge.Curriculum.Duel.*
#        One-on-one fights against a creature (the duel) or a player (PvP).

#   fraction of the opponent's health: a kill is worth this in damage
AnimusForge.Curriculum.Duel.DamageDealt = 2.0
#   fraction of the bot's health
AnimusForge.Curriculum.Duel.DamageTaken = 1.0
#   shaping toward the spec's range, per 40 yd closed
AnimusForge.Curriculum.Duel.Approach = 0.5
#   a harmful spell from stealth that breaks it (Ambush, Cheap Shot)
AnimusForge.Curriculum.Duel.StealthOpener = 0.5
#   one that keeps it (Sap, Distract), once per target per stealth
AnimusForge.Curriculum.Duel.StealthUtility = 0.05
#   per decision
AnimusForge.Curriculum.Duel.StepCost = 0.0002
#   winning outweighs winning fast: at Kill 10, FastKill 1 and a loss (Death, Timeout) at 10, a risky fast opener
#   only pays more than a sure slow win above ~97% odds
AnimusForge.Curriculum.Duel.Kill = 10.0
#   times the fraction of the episode length left, from the engagement
AnimusForge.Curriculum.Duel.FastKill = 1.0
#   times the fraction of the bot's health not lost; damage taken is already charged as it happens, so a large
#   value pays twice for the same thing and reads as "survive" rather than "win"
AnimusForge.Curriculum.Duel.HealthKept = 0.5
AnimusForge.Curriculum.Duel.Death = 10.0
#   a creature duel that runs out of time with neither side dead: a lost fight, ended as one (as Death, so neither
#   way of losing is the cheaper one)
AnimusForge.Curriculum.Duel.Timeout = 10.0
#   creature duel: per second the fight has not started once StallGraceMs are gone; Timeout alone charges standing
#   where it spawned only when the clock runs out, too far off for the policy to see
AnimusForge.Curriculum.Duel.Stall = 0.05
#   ... the time a seat has to summon, buff and sneak up before it (ms)
AnimusForge.Curriculum.Duel.StallGraceMs = 15000
#   ... which grows by the time spent starting buffs, forms, stances, stealth and pet summons out of combat (each its
#   cast time, at least a global cooldown), up to this much (ms)
AnimusForge.Curriculum.Duel.PreparationRefundMaxMs = 30000
#   creature duel, ranged specs: per second the opponent stands in melee range hitting the bot
AnimusForge.Curriculum.Duel.Spacing = 0.03
#   the range the approach shaping aims for, melee specs
AnimusForge.Curriculum.Duel.MeleeRange = 3.5
#   ... ranged specs
AnimusForge.Curriculum.Duel.RangedRange = 25.0

#
#    AnimusForge.Curriculum.Difficulty.*
#        How hard the creature duel's opponents are, per class/role. Tier t below EliteTier is a normal
#        creature t x LevelsPerTier levels above the seat; from EliteTier on an elite, (t - EliteTier) x
#        LevelsPerTier levels above. Evaluations spread their seeds over every tier.

#   the hardest tier
AnimusForge.Curriculum.Difficulty.MaxTier = 6
#   the first elite tier (above MaxTier: no elites)
AnimusForge.Curriculum.Difficulty.EliteTier = 4
AnimusForge.Curriculum.Difficulty.LevelsPerTier = 1
#   a class/role moves up a tier when it wins (kills without dying) this share of Window fights at its tier ...
AnimusForge.Curriculum.Difficulty.RaiseAbove = 0.9
#   ... and down below this share
AnimusForge.Curriculum.Difficulty.LowerBelow = 0.6
AnimusForge.Curriculum.Difficulty.Window = 200
#   percent of training fights drawn from a lower tier, so none is forgotten
AnimusForge.Curriculum.Difficulty.ReviewChance = 25

#
#    AnimusForge.Curriculum.Casting.*
#        Cast-time spells, from the duel stage on.

#   per second spent on a cast that did not finish
AnimusForge.Curriculum.Casting.TimeWasted = 0.03
#   per second of cast time of a cast that finished, in combat
AnimusForge.Curriculum.Casting.TimeCompleted = 0.03
#   per cast the bot cut short itself, whatever it had spent on it; TimeWasted alone charges by the second, so
#   stopping a cast the decision after starting it is nearly free and a deterministic policy can loop on it
AnimusForge.Curriculum.Casting.Cancel = 0.05
#   every stage, per decision: the bot's effective healing on itself plus what its own absorbs soaked and damage-taken
#   reductions prevented on itself, as a fraction of its health; below every DamageTaken so it never pays to be hit
AnimusForge.Curriculum.Support.SelfHealing = 0.5
#   gauntlets: engaging a pull pays this times the share of the class's buff groups up on the bot (and the owner)
AnimusForge.Curriculum.Support.BuffCoverage = 0.3

#
#    AnimusForge.Curriculum.Actions.*
#        How often a seat may press the same button, as a player would. A paced action is masked until it may be
#        pressed again, so a policy cannot sit re-issuing an order every decision (a pet sent in 125 times an
#        episode, a cast started and stopped over and over). Spells keep their own cooldowns as well. 0 = no pace.

#   the same action again: spells, orders, consumables, targeting (ms)
AnimusForge.Curriculum.Actions.RepeatMs = 1000
#   the same movement order again (ms)
AnimusForge.Curriculum.Actions.MoveRepeatMs = 300
#   a cast the bot is in cannot be stopped before it has run this long (ms)
AnimusForge.Curriculum.Actions.StopCastMinMs = 500
#   a spell the bot stopped itself cannot be started again for this long (ms)
AnimusForge.Curriculum.Actions.RecastAfterStopMs = 2000
#   per press of the same action past the free ones within RepeatWindowMs: pressing one button over and over,
#   however far apart the presses are paced (how often the seat acts overall is not charged; movement orders are
#   always free)
AnimusForge.Curriculum.Actions.Repeat = 0.02
#   the window the presses of one action are counted in (ms)
AnimusForge.Curriculum.Actions.RepeatWindowMs = 10000
#   presses of one action within the window that cost nothing
AnimusForge.Curriculum.Actions.RepeatFree = 3
#   a movement order back the way the last one went (in toward the target, then away, or the reverse) waits this
#   long (ms); movement is still free, only the reversal waits
AnimusForge.Curriculum.Actions.ReverseMoveMs = 1000
#   a stance, form, presence, aspect, aura, seal, armor or pet stance holds this long before another change of its
#   kind (ms)
AnimusForge.Curriculum.Actions.ModeLockMs = 5000

#
#    AnimusForge.Curriculum.Pulls.*
#        Packs and the gauntlet's pull after pull.

#   percent of pulls whose members aggro together
AnimusForge.Curriculum.Pulls.LinkedChance = 70
#   gauntlet: a single elite instead of a pack
AnimusForge.Curriculum.Pulls.EliteChance = 15
#   gauntlet: a pack 1-3 levels above the bot (at most 1 below level 20, 2 below 30)
AnimusForge.Curriculum.Pulls.HigherLevelChance = 25
#   party: per pack member
AnimusForge.Curriculum.Pulls.PartyEliteChance = 50
#   gauntlet: the break between pulls
AnimusForge.Curriculum.Pulls.NextPullMinMs = 8000
AnimusForge.Curriculum.Pulls.NextPullMaxMs = 20000
#   with an owner: when it walks over to a new pull
AnimusForge.Curriculum.Pulls.OwnerEngageMinMs = 1500
AnimusForge.Curriculum.Pulls.OwnerEngageMaxMs = 5000
#   ... in a party, after the tank has had time to pull
AnimusForge.Curriculum.Pulls.PartyOwnerEngageMinMs = 4000
AnimusForge.Curriculum.Pulls.PartyOwnerEngageMaxMs = 7000
#   ... when the owner starts the pull itself
AnimusForge.Curriculum.Pulls.OwnerPullsMinMs = 500
AnimusForge.Curriculum.Pulls.OwnerPullsMaxMs = 1500
#   percent of pulls a damage dealer or healer owner starts (tanks: all)
AnimusForge.Curriculum.Pulls.OwnerPullsChance = 30
#   owner stages: health and mana the dead stand up with after a pull
AnimusForge.Curriculum.Pulls.RecoverFraction = 0.5
#   fraction of the pull's total health
AnimusForge.Curriculum.Pulls.DamageDealt = 2.0
#   pack: fraction of the bot's health
AnimusForge.Curriculum.Pulls.DamageTaken = 1.0
#   gauntlet on: surviving many pulls matters more than any one
AnimusForge.Curriculum.Pulls.GauntletDamageTaken = 1.5
AnimusForge.Curriculum.Pulls.Approach = 0.5
AnimusForge.Curriculum.Pulls.StealthOpener = 0.5
AnimusForge.Curriculum.Pulls.StealthUtility = 0.05
AnimusForge.Curriculum.Pulls.Interrupt = 0.3
AnimusForge.Curriculum.Pulls.Kill = 0.5
#   per decision
AnimusForge.Curriculum.Pulls.StepCost = 0.0002
#   owner stages (the solo gauntlet has SoloGauntlet*), win-first: each pull cleared, and FastPull times
#   1 - its time since engaged / 60 s, both x OwnerClearScale; HealthKept times the seat's own health kept through it;
#   GauntletDeath per seat death (the owner's is Owner.Death)
AnimusForge.Curriculum.Pulls.Clear = 2.5
AnimusForge.Curriculum.Pulls.FastPull = 0.5
AnimusForge.Curriculum.Pulls.HealthKept = 0.5
AnimusForge.Curriculum.Pulls.GauntletDeath = 10.0
#   A single pack (stage2_pack) is won or lost, as the duel is: the clear outweighs finishing it untouched,
#   and dying or running out of time costs as much as the clear pays. With the gauntlet's Clear and HealthKept
#   the pack was worth 2 + 2, so keeping health paid as much as winning, and a death cost only 3.
AnimusForge.Curriculum.Pulls.PackClear = 10.0
#   pack: times the episode fraction left after engaging
AnimusForge.Curriculum.Pulls.FastClear = 1.0
#   pack: times the fraction of the bot's health not lost
AnimusForge.Curriculum.Pulls.PackHealthKept = 0.5
AnimusForge.Curriculum.Pulls.PackDeath = 10.0
#   pack: the clock ran out with the pack and the seat both alive; the episode ends as a lost fight
#   pack: the single pack's top ladder rung (0-5: 2, 3, 4 creatures with a caster, two casters, an elite, an elite a
#   level above), climbed per class/role at the Difficulty.* rates; 0 keeps every pack on the first rung
AnimusForge.Curriculum.Pulls.MaxTier = 5
AnimusForge.Curriculum.Pulls.Timeout = 10.0
#   pack: per second a fight goes on past OvertimeGraceMs after it was engaged, and a death in overtime is charged the
#   overtime left; a timeout alone, 150 s away, is too discounted to stop kiting out the clock
AnimusForge.Curriculum.Pulls.Overtime = 0.1
AnimusForge.Curriculum.Pulls.OvertimeGraceMs = 60000
#   pack: per second the pack has not been engaged once StallGraceMs of the episode are gone
AnimusForge.Curriculum.Pulls.Stall = 0.05
AnimusForge.Curriculum.Pulls.StallGraceMs = 15000
#   pack: the grace grows by the time spent starting buffs, forms, stances, stealth and pet summons out of combat (each
#   its cast time, at least a global cooldown), up to this much (ms)
AnimusForge.Curriculum.Pulls.PreparationRefundMaxMs = 30000
#   pack: per second a ranged spec is hit by a pack member in melee reach
AnimusForge.Curriculum.Pulls.Spacing = 0.03
#   solo gauntlet (pull after pull, no owner; won by lasting to the end with SoloGauntletWinPulls cleared): each pull
#   cleared, instead of Clear ...
AnimusForge.Curriculum.Pulls.SoloGauntletClear = 5.0
#   ... plus this times 1 - the pull's time since engaged / 60 s, instead of FastPull ...
AnimusForge.Curriculum.Pulls.SoloGauntletFastPull = 1.0
#   ... and this times the health kept through the pull, instead of HealthKept
AnimusForge.Curriculum.Pulls.SoloGauntletHealthKept = 0.5
#   solo gauntlet: a death, instead of GauntletDeath (it also forfeits every pull left)
AnimusForge.Curriculum.Pulls.SoloGauntletDeath = 10.0
#   solo gauntlet: engaging a pull pays this times the health fraction (the lower of health and mana for mana users)
#   the decision before: entering a fight ready is what resting between pulls is for
AnimusForge.Curriculum.Pulls.SoloGauntletReadiness = 0.5
#   solo gauntlet: lasting to the end is a win only with this many pulls cleared (fewer is a timeout)
AnimusForge.Curriculum.Pulls.SoloGauntletWinPulls = 5
#   solo gauntlet: food and drink stocked, each
AnimusForge.Curriculum.Pulls.GauntletSupplies = 7
#   solo gauntlet: per second per pack member kept out of the engaged fight by crowd control (stunned, incapacitated,
#   asleep, polymorphed, feared, or rooted out of melee reach and not casting), other than the seat's target, while
#   another member is alive ...
AnimusForge.Curriculum.Pulls.SoloGauntletControl = 0.02
#   ... up to this much per pull
AnimusForge.Curriculum.Pulls.SoloGauntletControlMax = 1.5
#   solo gauntlet: a pull nobody engaged comes to the seat this long after it spawned (ms) ...
AnimusForge.Curriculum.Pulls.ArriveMinMs = 20000
AnimusForge.Curriculum.Pulls.ArriveMaxMs = 40000
#   ... less this per pull cleared, down to ArriveFloorMs
AnimusForge.Curriculum.Pulls.ArriveShrinkMs = 1500
AnimusForge.Curriculum.Pulls.ArriveFloorMs = 10000
#   solo gauntlet: the break before the next pull shrinks by this per pull cleared, down to NextPullFloorMs (ms)
AnimusForge.Curriculum.Pulls.NextPullShrinkMs = 1000
AnimusForge.Curriculum.Pulls.NextPullFloorMs = 4000
#   owner stages: kills and clears count this many times
AnimusForge.Curriculum.Pulls.OwnerClearScale = 2.0
#   owner stages keep the solo gauntlet's lessons: readiness paid when a pull is engaged (times the lower of health and
#   mana), crowd control per enemy-second an add is kept out of the fight (up to OwnerControlMax a pull), and a win --
#   the episode lasted with the owner never dead, no wipe and OwnerWinPulls pulls cleared -- counted as the kill
AnimusForge.Curriculum.Pulls.OwnerReadiness = 0.5
AnimusForge.Curriculum.Pulls.OwnerControl = 0.02
AnimusForge.Curriculum.Pulls.OwnerControlMax = 1.5
AnimusForge.Curriculum.Pulls.OwnerWinPulls = 5

#
#    AnimusForge.Curriculum.Options.*
#        Description: How long a durative action may run before the seat has to choose again (ms). One press of
#                     one stands for many decisions: resting until health and mana are back, holding an interrupt
#                     for the target's next cast, or keeping a caster's distance. They also end on their own
#                     conditions, and any other action the policy takes cancels them.
#        Default:     30000 / 10000 / 10000
#
AnimusForge.Curriculum.Options.RestMaxMs = 30000
AnimusForge.Curriculum.Options.HoldInterruptMs = 10000
AnimusForge.Curriculum.Options.KeepRangeMs = 10000

#
#    AnimusForge.Curriculum.Owner.*
#        The scripted owner of the companion and party stages.

#   its level: the bot's plus or minus this
AnimusForge.Curriculum.Owner.LevelSpread = 2
#   percent tanks, healers, the rest damage dealers
AnimusForge.Curriculum.Owner.TankChance = 25
AnimusForge.Curriculum.Owner.HealerChance = 25
#   damage dealers: the owner's damage taken, fraction of its health
AnimusForge.Curriculum.Owner.DamageTakenDps = 1.0
#   tanks and healers exist to prevent it
AnimusForge.Curriculum.Owner.DamageTakenProtector = 2.0
#   a tank owner is hit by design: its damage taken counts this much
AnimusForge.Curriculum.Owner.TankOwnerDamageShare = 0.25
#   healers: effective healing, fraction of the owner's health
AnimusForge.Curriculum.Owner.Healing = 2.0
#   tanks: soften the pulls' damage taken
AnimusForge.Curriculum.Owner.TankDamageRefund = 0.5
#   tanks: per enemy on the tank, per decision
AnimusForge.Curriculum.Owner.TankHold = 0.002
#   tanks: per enemy on the owner, per decision
AnimusForge.Curriculum.Owner.TankLose = 0.02
#   damage dealers and healers: per enemy on the bot, per decision
AnimusForge.Curriculum.Owner.PulledThreat = 0.004
#   per decision in combat while the owner is not
AnimusForge.Curriculum.Owner.SoloFight = 0.01
#   per decision out of combat beyond FollowFarDistance
AnimusForge.Curriculum.Owner.FollowFar = 0.002
#   per decision out of combat within FollowNearDistance
AnimusForge.Curriculum.Owner.FollowNear = 0.0005
AnimusForge.Curriculum.Owner.FollowFarDistance = 25.0
AnimusForge.Curriculum.Owner.FollowNearDistance = 12.0
AnimusForge.Curriculum.Owner.Death = 15.0

#
#    AnimusForge.Curriculum.Resurrection.*
#        Resurrecting: a seat's own Soulstone or Reincarnation, and revives on allies (companion
#        and party stages). Nobody is revived automatically while a resurrection is possible.

#   the dead wait this long (ms) for a resurrection they can get before solo stages end and
#   owner stages stand them up (the next pull waits too)
AnimusForge.Curriculum.Resurrection.GraceMs = 20000
#   a dead ally the seat resurrected stood up
AnimusForge.Curriculum.Resurrection.ReviveAlly = 1.5

#
#    AnimusForge.Curriculum.Opponent.*
#        The scripted enemy player of the PvP stage.

AnimusForge.Curriculum.Opponent.LevelSpread = 1
#   it starts fighting up to this long into the episode
AnimusForge.Curriculum.Opponent.EngageMaxMs = 3000
AnimusForge.Curriculum.Opponent.HealerChance = 20
AnimusForge.Curriculum.Opponent.TankChance = 20

#
#    AnimusForge.Curriculum.Ambush.*
#        Scripted enemy players who ambush the owner (stage8_crossroads' ambush and escort_duel arenas).
#        Their class, role and level follow the Opponent.* chances and spread.

#   beside pulls: they arrive at a random time between these, in ms (at most 3/4 into the episode)
AnimusForge.Curriculum.Ambush.MinMs = 20000
AnimusForge.Curriculum.Ambush.MaxMs = 120000
#   they start fighting up to this long after arriving, in ms
AnimusForge.Curriculum.Ambush.EngageMaxMs = 3000
#   beside pulls: every seat is paid this per ambusher killed (alone, the duel's rewards apply)
AnimusForge.Curriculum.Ambush.Kill = 3.0

#
#    AnimusForge.Curriculum.ScriptedPlayers.*
#        How the scripted players (owner, PvP opponent, ambushers) play.

#   time between damage spells
AnimusForge.Curriculum.ScriptedPlayers.SpellMinMs = 2000
AnimusForge.Curriculum.ScriptedPlayers.SpellMaxMs = 4000
#   time between heals
AnimusForge.Curriculum.ScriptedPlayers.HealMinMs = 1500
AnimusForge.Curriculum.ScriptedPlayers.HealMaxMs = 2500
#   between pulls: time between wander steps
AnimusForge.Curriculum.ScriptedPlayers.WanderMinMs = 6000
AnimusForge.Curriculum.ScriptedPlayers.WanderMaxMs = 12000
#   of max health and mana per second, out of combat
AnimusForge.Curriculum.ScriptedPlayers.RegenFraction = 0.04
#   healers heal party members under this health fraction
AnimusForge.Curriculum.ScriptedPlayers.HealBelow = 0.85
#   PvP healers heal themselves under this
AnimusForge.Curriculum.ScriptedPlayers.SelfHealBelow = 0.6
#   healers stay this close to the tank
AnimusForge.Curriculum.ScriptedPlayers.HealerRange = 30.0
AnimusForge.Curriculum.ScriptedPlayers.TauntRange = 25.0
#   PvP: a ranged spec backs off inside half this ...
AnimusForge.Curriculum.ScriptedPlayers.RangedMin = 20.0
#   ... and closes in beyond this
AnimusForge.Curriculum.ScriptedPlayers.RangedMax = 30.0
#   PvP: percent of engagements a rogue sneaks up in stealth
AnimusForge.Curriculum.ScriptedPlayers.StealthChance = 50
#   PvP: percent of engagements it plays its kit: interrupts, crowd control, snares, defensives, breaks
AnimusForge.Curriculum.ScriptedPlayers.TacticsChance = 75
#   ... time between crowd control attempts
AnimusForge.Curriculum.ScriptedPlayers.ControlMinMs = 8000
AnimusForge.Curriculum.ScriptedPlayers.ControlMaxMs = 15000
#   ... a defensive when its health is under this
AnimusForge.Curriculum.ScriptedPlayers.DefensiveBelow = 0.35
#   ... breaks crowd control when its health is under this
AnimusForge.Curriculum.ScriptedPlayers.BreakBelow = 0.6

#   Travel arenas. Ground: a place this many yards away by path
AnimusForge.Curriculum.Travel.ObjectiveMin = 60.0
AnimusForge.Curriculum.Travel.ObjectiveMax = 320.0
#   flying arenas: yards from the start
AnimusForge.Curriculum.Travel.FlyingMin = 350.0
AnimusForge.Curriculum.Travel.FlyingMax = 700.0
#   potential shaping: per 100 yd closed (taken back for leaving)
AnimusForge.Curriculum.Travel.Progress = 1.0
AnimusForge.Curriculum.Travel.Arrive = 3.0
#   times the fraction of the episode still left
AnimusForge.Curriculum.Travel.FastArrive = 3.0
#   fraction of the bot's health (falls, what it rode past)
AnimusForge.Curriculum.Travel.DamageTaken = 1.0
AnimusForge.Curriculum.Travel.Death = 3.0
#   per decision
AnimusForge.Curriculum.Travel.StepCost = 0.0002

#   Flag match (Warsong Gulch's rules). Yards between the bases, by path
AnimusForge.Curriculum.Flag.BaseMin = 100.0
AnimusForge.Curriculum.Flag.BaseMax = 180.0
AnimusForge.Curriculum.Flag.CapturesToWin = 3
#   the dead stand up at their base after this (a graveyard wave)
AnimusForge.Curriculum.Flag.RespawnMs = 15000
#   a dropped flag goes home on its own after this
AnimusForge.Curriculum.Flag.DroppedReturnMs = 10000
#   yards to pick up, return or capture
AnimusForge.Curriculum.Flag.TouchDistance = 4.0
AnimusForge.Curriculum.Flag.Capture = 5.0
AnimusForge.Curriculum.Flag.Pickup = 1.0
AnimusForge.Curriculum.Flag.Return = 1.0
#   killing the one carrying the seat's flag
AnimusForge.Curriculum.Flag.CarrierKill = 1.5
#   the other side captured the seat's flag
AnimusForge.Curriculum.Flag.Lost = 3.0
#   potential shaping toward the seat's current objective, per 100 yd
AnimusForge.Curriculum.Flag.Progress = 0.5
AnimusForge.Curriculum.Flag.Death = 1.0
#   per decision
AnimusForge.Curriculum.Flag.StepCost = 0.0002

